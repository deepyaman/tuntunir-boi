---
// A centered picture with an optional caption underneath, the way the printed book lays them out.
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  src: ImageMetadata;
  alt: string;
  caption?: string;
}

const { src, alt, caption } = Astro.props;
---

<figure>
  <Image src={src} alt={alt} widths={[720, 1440]} sizes="(min-width: 44rem) 38rem, calc(100vw - 2rem)" />
  {caption && <figcaption>{caption}</figcaption>}
</figure>
