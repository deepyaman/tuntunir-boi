---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';

const stories = (await getCollection('stories')).sort((a, b) => a.data.order - b.data.order);
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<Base title="Ṭunṭunir Boi">
  <h1>Ṭunṭunir Boi</h1>
  <p class="byline">Upendrakishore Ray Chowdhury</p>
  <p>
    Stories from <em>Tuntunir Boi</em> in romanized Bengali, with the original
    illustrations, for readers who speak Bengali but do not read the script.
  </p>
  <ol class="contents">
    {stories.map((story) => (
      <li><a href={`${base}/stories/${story.id}/`}>{story.data.title}</a></li>
    ))}
  </ol>
</Base>
